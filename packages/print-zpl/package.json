{
  "name": "@yinshu-print/print-zpl",
  "version": "0.1.0",
  "description": "Fill ZPL {{keys}} as-is and send RAW to Yinshu. Not PDF / ARJS.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "wu9007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wu9007/yinshu-demo.git",
    "directory": "packages/print-zpl"
  },
  "homepage": "https://github.com/wu9007/yinshu-demo/tree/main/packages/print-zpl",
  "bugs": {
    "url": "https://github.com/wu9007/yinshu-demo/issues"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "main": "./dist/print-zpl.es.js",
  "module": "./dist/print-zpl.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/print-zpl.es.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "tsc": "vue-tsc --declaration --emitDeclarationOnly --outDir dist -p ./tsconfig.build.json",
    "prepublishOnly": "npm run build && npm run tsc",
    "pub": "npm publish --access public --registry https://registry.npmjs.org/"
  },
  "keywords": [
    "yinshu",
    "zpl",
    "print",
    "raw"
  ]
}
